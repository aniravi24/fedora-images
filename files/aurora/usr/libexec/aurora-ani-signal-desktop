#!/usr/bin/bash
# Regenerate the Signal launcher override from the Flatpak's own .desktop file.
#
# Signal stores its database key in the OS keyring. On KDE that is kwallet6, but
# the Flatpak's autodetection picks basic_text and then refuses to start:
#   "OS encryption keyring backend has changed from kwallet6 to basic_text"
# The fix is the --password-store=kwallet6 flag. `flatpak override` can set
# permissions and environment variables but cannot add command-line arguments,
# so a shadowing .desktop file in ~/.local/share/applications is the only route.
#
# Copying the file once freezes it: when Signal updates and upstream changes its
# Exec line, the stale copy keeps shadowing the new one. So derive the override
# from upstream every time and patch only the Exec line. Idempotent, and a
# no-op when the result already matches.
set -uo pipefail

FLAG="--password-store=kwallet6"
SRC=/var/lib/flatpak/exports/share/applications/org.signal.Signal.desktop
[ -f "$SRC" ] || exit 0

for home in /var/home/*; do
  user=${home#/var/home/}
  id -u "$user" >/dev/null 2>&1 || continue
  dest="$home/.local/share/applications/org.signal.Signal.desktop"

  generated=$(printf '%s\n' \
    "# Generated by aurora-ani-signal-desktop. Do not edit; regenerated from" \
    "# $SRC" \
    "# whenever Signal updates. Adds $FLAG so Signal reads its" \
    "# database key from KWallet instead of falling back to basic_text."
    # Add the flag to Exec, but only if it is not already there.
    sed "/^Exec=/{ /$FLAG/!s|^\(Exec=.*org\.signal\.Signal\)|\1 $FLAG| }" "$SRC")

  if [ ! -f "$dest" ] || [ "$(cat "$dest")" != "$generated" ]; then
    install -d -o "$user" -g "$user" "$(dirname "$dest")"
    printf '%s\n' "$generated" > "$dest"
    chown "$user":"$user" "$dest"
    command -v update-desktop-database >/dev/null 2>&1 && \
      update-desktop-database "$(dirname "$dest")" 2>/dev/null
    echo "regenerated $dest"
  fi
done
exit 0
