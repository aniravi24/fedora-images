# Taken from Aurora's own cli.Brewfile (`ujust aurora-cli`). Only the pieces
# that do not fight the existing shell: aurora-cli also installs starship and
# atuin and runs `ublue-bling`, which appends to .zshrc and would collide with
# zprezto + powerlevel10k.
# SQLite-backed shell history: fuzzy Ctrl-R, records exit code, duration, cwd
# and host per command. Rebinds Ctrl-R and up-arrow only, so it coexists with
# powerlevel10k. Import the existing history once with `atuin import auto`.
# Installed but NOT activated: the prompt stays powerlevel10k until .zshrc
# says otherwise. Starship has no native jj support yet (starship#6969, #7224
# are still open) and no instant-prompt equivalent, so this is here to A/B
# against p10k, not to replace it.
brew "starship"
brew "atuin"
# Dotfiles. Bootstrap order is in the repo README; the age key has to be in
# place before `chezmoi init --apply` can decrypt anything.
brew "chezmoi"
brew "age"
brew "gh"
brew "ripgrep"
brew "yq"
brew "trash-cli"
brew "tealdeer"
